# TopCV crawler. Paths are relative to the repository root.
# Blank optional values use the defaults described below.
JOBS_CHANNEL=chrome
JOBS_HEADLESS=false
JOBS_DELAY=15
JOBS_TIMEOUT=30
JOBS_RESUME_COOLDOWN=30

# Blank END crawls until the source ends; resume retains its saved target.
JOBS_END=
# Blank START resumes pending work; set START to begin a new pass.
JOBS_START=
JOBS_MAX_JOBS=

# A fresh run creates data/raw/jobs/<run_id> unless OUTPUT_DIRECTORY is set.
# Set RESUME to an existing run directory to continue its dataset.
# Choose one of RESUME and OUTPUT_DIRECTORY.
JOBS_RESUME=
JOBS_OUTPUT_DIRECTORY=
